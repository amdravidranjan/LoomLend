# Database: leave unset locally to use ./local.db (SQLite). In production, use a Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signs session cookies. Use a long random string in production.
SESSION_SECRET=

# Optional: enables Claude-written advisory notes. Without it, rule-based notes are used.
ANTHROPIC_API_KEY=

# "false" enforces real check-in time windows and no-show detection. Leave unset for judging.
DEMO_MODE=
# "false" hides the admin "Reset demo data" button.
ALLOW_DEMO_RESET=
# Optional: protects /api/cron/sweep (Vercel sends it automatically as a Bearer token).
CRON_SECRET=
